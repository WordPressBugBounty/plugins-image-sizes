{
    "name": "image-sizes/image-sizes",
    "description": "Ecommerce with WordPress made easy.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "Codexpert\\ThumbPress\\": "app/"
        },
        "files": ["app/Helpers/functions.php","app/Config/autoload.php"]
    },
    "authors": [
        {
            "name": "Codexpert, Inc"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/codexpertio/plugin.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/pluggableio/marketing.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "codexpert/plugin": "dev-master",
        "pluggable/marketing": "dev-master",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "brain/monkey": "^2.6",
        "wp-cli/wp-cli": "^2.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^9.3",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.30"
        }
    },
    "scripts": {
        "makepot": "wp i18n make-pot . languages/image-sizes.pot --exclude=node_modules,vendor,docs,legacy,spa,release,sample-data,tests --allow-root",
        "release": [
            "rm -rf release vendor build/*",
            "npm run build",
            "@makepot",
            "mkdir -p release",
            "composer install --no-dev --optimize-autoloader",
            "rsync -av --exclude-from=.distignore . release/image-sizes/",
            "cp legacy/composer.json release/image-sizes/legacy/composer.json",
            "cd release/image-sizes/legacy && rm -rf vendor && composer install --no-dev --optimize-autoloader && rm -rf composer.*",
            "cd release && zip -r image-sizes.zip image-sizes/",
            "rm -rf release/image-sizes/",
            "composer install",
            "cd legacy && composer install"
        ]
    }
}
