{
    "name": "image-sizes/image-sizes",
    "description": "Ecommerce with WordPress made easy.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "Codexpert\\ThumbPress\\": "app/"
        },
        "files": ["app/Helpers/functions.php","app/Config/autoload.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Codexpert\\ThumbPress\\Tests\\": "tests/php/src/"
        }
    },
    "authors": [
        {
            "name": "Codexpert, Inc"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/codexpertio/plugin.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/pluggableio/marketing.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "codexpert/plugin": "dev-master",
        "pluggable/marketing": "dev-master",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.6",
        "yoast/phpunit-polyfills": "^1.0",
        "brain/monkey": "^2.6",
        "wp-cli/wp-cli": "^2.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^9.3",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.30"
        }
    },
    "scripts": {
        "test": "php -d auto_prepend_file=tests/php/define-abspath.php vendor/bin/phpunit",
        "test-f": "php -d auto_prepend_file=tests/php/define-abspath.php vendor/bin/phpunit --filter",
        "phpcs": "php -d auto_prepend_file=tests/php/define-abspath.php vendor/bin/phpcs",
        "phpcbf": "php -d auto_prepend_file=tests/php/define-abspath.php vendor/bin/phpcbf",
        "makepot": "wp i18n make-pot . languages/image-sizes.pot --exclude=node_modules,vendor,docs,spa,release,sample-data,tests --allow-root",
        "release": [
            "rm -rf release vendor build/*",
            "npm run build",
            "@makepot",
            "mkdir -p release",
            "composer install --no-dev --optimize-autoloader",
            "rsync -av --exclude-from=.distignore . release/image-sizes/",
            "find release/image-sizes -type f \\( -name '*.bak' -o -name '*.tmp' -o -name '*.log' -o -name '*.orig' -o -name '*.dist' \\) -delete",
            "cd release && zip -r image-sizes.zip image-sizes/",
            "rm -rf release/image-sizes/",
            "composer install"
        ]
    }
}
