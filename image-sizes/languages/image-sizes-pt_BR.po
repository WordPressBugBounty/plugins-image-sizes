msgstr "Pronto para comprimir suas imagens?"

#: build/admin.js:13
msgid "Configure your compression settings above and click \"Compress Now\" to optimize your image library."
msgstr "Ajuste suas configurações de compressão acima e clique em \"Comprimir agora\" para otimizar sua biblioteca de imagens."

#: build/admin.js:13
msgid "Quality Level"
msgstr "Nível de qualidade"

#: build/admin.js:13
msgid "Compression quality from 0-100. Higher values preserve more detail but result in larger files. 80+ recommended for best results."
msgstr "Qualidade da compressão de 0 a 100. Valores mais altos preservam mais detalhes, mas geram arquivos maiores. Recomenda-se 80 ou mais para melhores resultados."

#: build/admin.js:13
msgid "e.g. 80 (0-100)"
msgstr "ex.: 80 (0-100)"

#: build/admin.js:13
msgid "Compress In Background"
msgstr "Comprimir em segundo plano"

